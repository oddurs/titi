{
  "name": "titi",
  "version": "1.0.0",
  "private": true,
  "description": "A browser graphing calculator with the TI-84 keypad and none of its pixels.",
  "license": "MIT",
  "author": "Oddur Sigurdsson",
  "homepage": "https://oddurs.github.io/titi/",
  "repository": {
    "type": "git",
    "url": "https://github.com/oddurs/titi.git"
  },
  "bugs": {
    "url": "https://github.com/oddurs/titi/issues"
  },
  "keywords": [
    "calculator",
    "graphing-calculator",
    "ti-84",
    "canvas",
    "nextjs",
    "pwa"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 9991",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:goldens": "UPDATE_GOLDENS=1 tsx scripts/golden.test.ts",
    "icons": "tsx scripts/icons.ts",
    "verify": "npm run build && node scripts/verify.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
